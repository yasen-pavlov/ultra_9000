{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local bundled UI of the main window: workspace/session control commands, workspace-state events and window dragging from the bottom strip. No dialog, shell or filesystem plugin authority; the folder picker is a native app command.",
  "local": true,
  "windows": ["main"],
  "platforms": ["macOS", "linux"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-workspace-state",
    "allow-item-launch",
    "allow-item-resume",
    "allow-item-restart",
    "allow-item-select",
    "allow-item-close",
    "allow-notice-dismiss",
    "allow-sheet-open",
    "allow-sheet-close",
    "allow-app-quit",
    "allow-last-set-resume",
    "allow-last-set-dismiss",
    "allow-ui-set",
    "allow-path-check",
    "allow-pick-directory",
    "allow-conversations-list",
    "allow-settings-state",
    "allow-settings-set",
    "allow-settings-reset",
    "allow-settings-open-file",
    "allow-settings-reveal",
    "allow-terminal-set-viewport",
    "allow-terminal-focus",
    "allow-app-hide",
    "allow-app-request-quit"
  ]
}
