{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "outDir": "node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "svelte.config.js"]
}
