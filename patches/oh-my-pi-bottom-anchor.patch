diff --git a/packages/coding-agent/test/composer-bottom-anchor.test.ts b/packages/coding-agent/test/composer-bottom-anchor.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/composer-bottom-anchor.test.ts
@@ -0,0 +1,252 @@
+import { beforeAll, describe, expect, it } from "bun:test";
+import { TranscriptContainer } from "@oh-my-pi/pi-tui/chrome/transcript-container";
+import { COMPOSER_DEFAULTS, Composer } from "@oh-my-pi/pi-tui/prompt/composer";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+import { Text } from "@oh-my-pi/pi-tui";
+import { VirtualRenderScheduler } from "../../tui/test/virtual-render-scheduler";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal";
+import { withoutTerminalMultiplexer } from "../../tui/test/helpers/terminal-multiplexer";
+
+withoutTerminalMultiplexer();
+
+const COLUMNS = 80;
+
+function plain(rows: readonly string[]): string[] {
+	return rows.map(row => Bun.stripANSI(row).trimEnd());
+}
+
+function rowOf(rows: readonly string[], needle: string): number {
+	return rows.findIndex(row => row.includes(needle));
+}
+
+function transcriptOf(blocks: readonly (readonly string[])[]): TranscriptContainer {
+	const transcript = new TranscriptContainer();
+	for (const rows of blocks) transcript.addChild({ render: () => rows });
+	return transcript;
+}
+
+function startComposer(
+	rows: number,
+	preferences: Partial<typeof COMPOSER_DEFAULTS> = {},
+): { terminal: VirtualTerminal; scheduler: VirtualRenderScheduler; composer: Composer } {
+	const terminal = new VirtualTerminal(COLUMNS, rows);
+	const scheduler = new VirtualRenderScheduler();
+	const composer = new Composer({
+		terminal,
+		tuiOptions: { renderScheduler: scheduler },
+		preferences: { ...COMPOSER_DEFAULTS, quiet: true, ...preferences },
+	});
+	return { terminal, scheduler, composer };
+}
+
+beforeAll(async () => {
+	await initTheme();
+});
+
+describe("composer bottom anchoring", () => {
+	it("paints an underfull bootstrap frame with the editor on the final rows", async () => {
+		const rows = 20;
+		const { terminal, scheduler, composer } = startComposer(rows);
+		composer.editor.setText("DRAFT");
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+
+		const view = plain(terminal.getViewport());
+		const editorRows = plain(composer.editor.render(COLUMNS));
+		const editorTop = rows - editorRows.length;
+		// Regression: the short bootstrap frame used to sit at row zero with
+		// blank rows below the editor.
+		expect(rowOf(view, "DRAFT")).toBe(editorTop + rowOf(editorRows, "DRAFT"));
+		expect(view.slice(0, editorTop).every(row => row === "")).toBe(true);
+		composer.stop();
+	});
+
+	it("keeps an underfull runtime frame bottom-anchored through a height grow", async () => {
+		const { terminal, scheduler, composer } = startComposer(20);
+		composer.setRuntimeChildren([transcriptOf([["block-0"], ["block-1"]]), new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+
+		let view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(19);
+		expect(view[0]).toBe("");
+		expect(rowOf(view, "block-0")).toBeLessThan(rowOf(view, "block-1"));
+
+		// The transient resize-buffer paint must not jump to the top and back.
+		const transient = plain(composer.renderResizeFrame({ columns: COLUMNS, rows: 30 }));
+		expect(transient).toHaveLength(30);
+		expect(rowOf(transient, "EDITOR")).toBe(29);
+
+		terminal.resize(COLUMNS, 30);
+		await scheduler.advance(terminal, 300);
+		await scheduler.settle(terminal);
+
+		view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(29);
+		const buffer = plain(terminal.getScrollBuffer());
+		expect(buffer.filter(row => row === "block-0")).toHaveLength(1);
+		expect(buffer.filter(row => row === "block-1")).toHaveLength(1);
+		composer.stop();
+	});
+
+	it("pads only below history still on screen, never pushing it into scrollback", async () => {
+		const rows = 20;
+		const { terminal, scheduler, composer } = startComposer(rows);
+		const retired = Array.from({ length: 16 }, (_, index) => `A ${index}`);
+		composer.setRuntimeChildren([transcriptOf([retired, ["B 0", "B 1", "B 2"]]), new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+
+		// Block A retires under capacity pressure and the live tail underfills.
+		// The retired rows the terminal still shows stay directly above it; a
+		// blank band there would mean the padding displaced visible history.
+		const view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(rows - 1);
+		expect(rowOf(view, "A 15")).toBeGreaterThanOrEqual(0);
+		expect(rowOf(view, "A 15")).toBeLessThan(rowOf(view, "B 0"));
+		expect(view[0]).not.toBe("");
+
+		const buffer = plain(terminal.getScrollBuffer());
+		expect(buffer.filter(row => row.startsWith("A "))).toEqual(retired);
+		composer.stop();
+	});
+
+	it("repaints the first destructive reset frame bottom-anchored from row zero", async () => {
+		const rows = 20;
+		const { terminal, scheduler, composer } = startComposer(rows);
+		const transcript = transcriptOf([Array.from({ length: 16 }, (_, index) => `A ${index}`), ["B 0", "B 1", "B 2"]]);
+		composer.setRuntimeChildren([transcript, new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+		expect(composer.ui.getMutableViewport().top).toBeGreaterThan(0);
+
+		// A clear drops the transcript before the destructive repaint, so nothing
+		// replays: that paint restarts at row zero while the published origin is
+		// still the pre-clear one. Regression: subtracting it left the editor
+		// that many rows above the bottom until some later frame.
+		transcript.clear();
+		composer.ui.requestRender(true, { clearScrollback: true });
+		await scheduler.settle(terminal);
+
+		const view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(rows - 1);
+		expect(view.slice(0, rows - 1).every(row => row === "")).toBe(true);
+		composer.stop();
+	});
+
+	it("paints the first frame after a fullscreen overlay closes over a destructive reset from row zero", async () => {
+		const rows = 20;
+		const { terminal, scheduler, composer } = startComposer(rows);
+		const transcript = transcriptOf([Array.from({ length: 16 }, (_, index) => `A ${index}`), ["B 0", "B 1", "B 2"]]);
+		composer.setRuntimeChildren([transcript, new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+		expect(composer.ui.getMutableViewport().top).toBeGreaterThan(0);
+
+		// A session switch clears and resets while its fullscreen selector still
+		// owns the alt buffer, where the mutable viewport is unavailable. Closing
+		// the selector republishes the stale pre-reset origin just before the
+		// fused destructive repaint, which must still paint from row zero.
+		const overlay = composer.ui.showOverlay(new Text("SELECTOR", 0, 0), { fullscreen: true });
+		await scheduler.settle(terminal);
+		transcript.clear();
+		composer.ui.requestRender(true, { clearScrollback: true });
+		await scheduler.settle(terminal);
+		const renderFrame = composer.renderFrame.bind(composer);
+		let resumedFrames = 0;
+		composer.renderFrame = viewport => {
+			resumedFrames++;
+			return renderFrame(viewport);
+		};
+		overlay.hide();
+		await scheduler.settle(terminal);
+
+		// Only the fused repaint ran: this is the first resumed frame, not a
+		// later frame that happened to correct it.
+		expect(resumedFrames).toBe(1);
+		const view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(rows - 1);
+		expect(view.slice(0, rows - 1).every(row => row === "")).toBe(true);
+		composer.stop();
+	});
+
+	it("keeps the frame after a rebuild replay bottom-anchored", async () => {
+		const { terminal, scheduler, composer } = startComposer(20, { resizeScrollback: "rebuild" });
+		const retired = Array.from({ length: 12 }, (_, index) => `A ${index}`);
+		const live = Array.from({ length: 10 }, (_, index) => `B ${index}`);
+		composer.setRuntimeChildren([transcriptOf([retired, live]), new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+		expect(composer.ui.getMutableViewport().top).toBeGreaterThan(0);
+
+		// The settled grow replays the retired ledger from a full-height split.
+		// Regression: the frame after the replay subtracted an origin skewed by
+		// the replay's pad and lifted the editor off the bottom.
+		terminal.resize(COLUMNS, 30);
+		await scheduler.advance(terminal, 300);
+		await scheduler.settle(terminal);
+
+		// No further render: the settled state itself must be pinned.
+		const view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(29);
+		const buffer = plain(terminal.getScrollBuffer());
+		expect(buffer.filter(row => /^[AB] \d+$/.test(row))).toEqual([...retired, ...live]);
+		composer.stop();
+	});
+
+	it("anchors below a nonzero origin when a later frame offers more history", async () => {
+		const rows = 20;
+		const { terminal, scheduler, composer } = startComposer(rows);
+		const transcript = transcriptOf([Array.from({ length: 16 }, (_, index) => `A ${index}`), ["B 0", "B 1", "B 2"]]);
+		composer.setRuntimeChildren([transcript, new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+		expect(composer.ui.getMutableViewport().top).toBeGreaterThan(0);
+
+		// Grow the live tail past capacity from that nonzero origin: B retires
+		// in the same frame the new block arrives.
+		transcript.addChild({ render: () => Array.from({ length: 12 }, (_, index) => `C ${index}`) });
+		transcript.addChild({ render: () => Array.from({ length: 6 }, (_, index) => `D ${index}`) });
+		composer.ui.requestRender();
+		await scheduler.settle(terminal);
+
+		const view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(rows - 1);
+		expect(rowOf(view, "D 5")).toBeLessThan(rows - 1);
+		const buffer = plain(terminal.getScrollBuffer()).filter(row => /^[ABCD] \d+$/.test(row));
+		const expected = [
+			...Array.from({ length: 16 }, (_, index) => `A ${index}`),
+			"B 0",
+			"B 1",
+			"B 2",
+			...Array.from({ length: 12 }, (_, index) => `C ${index}`),
+			...Array.from({ length: 6 }, (_, index) => `D ${index}`),
+		];
+		// Contiguous, exactly once: the padding neither dropped nor duplicated rows.
+		expect(buffer).toEqual(expected);
+		composer.stop();
+	});
+
+	it("stays bottom-anchored after retired rows rewrap into more physical rows", async () => {
+		const rows = 20;
+		const { terminal, scheduler, composer } = startComposer(rows, { resizeScrollback: "preserve" });
+		const wide = Array.from({ length: 16 }, (_, index) => `W ${index} ${"x".repeat(60)}`);
+		composer.setRuntimeChildren([transcriptOf([wide, ["B 0", "B 1", "B 2"]]), new Text("EDITOR", 0, 0)]);
+		composer.start({ playWelcomeIntro: false });
+		await scheduler.settle(terminal);
+
+		// Narrowing rewraps each visible retired row onto two terminal rows, so
+		// the physical origin moves; padding must follow it, not line counts.
+		terminal.resize(40, rows);
+		await scheduler.advance(terminal, 300);
+		await scheduler.settle(terminal);
+
+		const view = plain(terminal.getViewport());
+		expect(rowOf(view, "EDITOR")).toBe(rows - 1);
+		expect(rowOf(view, "B 2")).toBeLessThan(rows - 1);
+		const buffer = plain(terminal.getScrollBuffer());
+		expect(buffer.filter(row => row === "B 0")).toHaveLength(1);
+		expect(buffer.filter(row => row === "EDITOR")).toHaveLength(1);
+		composer.stop();
+	});
+});
